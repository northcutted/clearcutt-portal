---
import Layout from '../../layouts/Layout.astro';
import PackagesUnknown from '../../components/PackagesUnknown.astro';
import { loadBundle } from '../../lib/bundle.ts';
import { packageGroups } from '../../lib/estate.ts';
import { plural } from '../../lib/format.ts';
import { QUERY_EXAMPLES } from '../../lib/package-search.ts';
import { href, packageHref } from '../../lib/site.ts';

const { report } = loadBundle();
const groups = packageGroups(report);
const { known, unknown } = report.summary.packages;
---
<Layout title="Packages" description="Which images ship which package versions.">
  <header class="page-head">
    <p class="eyebrow">Packages</p>
    <h1>Which images ship a package</h1>
    <p class="lede">
      {plural(groups.length, 'package')} in {plural(report.packages.length, 'version')}, read from the package sets of{' '}
      {plural(known, 'image')}. {unknown > 0 ? `${plural(unknown, 'image is', 'images are')} not covered.` : ''}
    </p>
  </header>

  <PackagesUnknown />

  <section aria-labelledby="search">
    <h2 id="search">Who ships a version</h2>
    <p class="lede small">
      A package name, and the versions you're after. The answer lists the images that ship a matching version, and
      the images built on one of those, which inherit it from their base.
    </p>
    <div data-package-search data-index={href('packages/search-index.json')} hidden>
      <p>
        <input class="filter" type="search" placeholder={QUERY_EXAMPLES[0]} aria-label="Package and versions, e.g. libxml2 <2.14" aria-describedby="search-syntax" autocomplete="off" spellcheck="false" data-search-input />
      </p>
      <details id="search-syntax" class="small">
        <summary>How to write a search</summary>
        <ul class="syntax">
          <li>A package name, in any case. <code>*</code> matches anything: <code>libxml2*</code>.</li>
          <li>Then versions: <code>&lt;</code>, <code>&lt;=</code>, <code>&gt;</code>, <code>&gt;=</code>, <code>=</code>, or <code>!=</code> and a version. A comma or space means "and", <code>||</code> means "or": {QUERY_EXAMPLES.slice(1).map((q, i) => <>{i > 0 && ', '}<code>{q}</code></>)}. No versions means any version.</li>
          <li>A type before the name, like <code>deb:</code>, <code>rpm:</code>, or <code>apk:</code>, keeps to that kind of package.</li>
          <li>
            Versions are ordered the way their ecosystem orders them: apk for Alpine and Wolfi, dpkg for Debian (where <code>~</code> comes
            before a release), rpm, semver for Go, npm, and Cargo, and PEP 440 for Python. A version without an epoch or a
            revision ignores the package's: <code>&lt;2.14.0</code> holds for <code>2.13.9-r5</code> and not for <code>2.14.0-r1</code>.
          </li>
        </ul>
      </details>
      <p class="small" data-search-status aria-live="polite"></p>
      <div data-search-results></div>
    </div>
    <noscript>
      <p class="small">
        Searching by version needs JavaScript. Without it, open a package below: its page lists every version, the images
        that ship each, and the images built on them.
      </p>
    </noscript>
  </section>

  <section aria-labelledby="list">
    <h2 id="list">All packages</h2>
    <p><input class="filter" type="search" placeholder="Filter by name or type, e.g. openssl" aria-label="Filter packages" data-filter data-filter-noun="packages" /></p>
    <p class="small dim" data-count aria-live="polite"></p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Package</th><th>Type</th><th>Versions</th><th class="num">Images</th></tr></thead>
        <tbody>
          {groups.map((g) => (
            <tr data-text={`${g.name} ${g.type}`.toLowerCase()}>
              <td><a href={packageHref(g.slug)}>{g.name}</a></td>
              <td>{g.type}</td>
              <td class="mono small">{g.versions.map((v) => v.version).join(', ')}</td>
              <td class="num">{g.images.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script src="../../scripts/package-search.ts"></script>

<script src="../../scripts/filter-rows.ts"></script>
