---
import Layout from '../../layouts/Layout.astro';
import Chip from '../../components/Chip.astro';
import Digest from '../../components/Digest.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import ImageScans from '../../components/ImageScans.astro';
import LineChart from '../../components/LineChart.astro';
import StatusText from '../../components/StatusText.astro';
import VerdictChip from '../../components/VerdictChip.astro';
import VerifyCommands from '../../components/VerifyCommands.astro';
import type { Point } from '../../lib/charts.ts';
import type { Image } from '../../lib/contract.gen.ts';
import { loadBundle } from '../../lib/bundle.ts';
import {
  consumersOf,
  daysBehind,
  imageLabel,
  imageRuns,
  imagesById,
  packagesOf,
  rebasesOf,
  stackAnchor,
  stackOf,
} from '../../lib/estate.ts';
import { bytes, formatEpochDay, formatTime, plural } from '../../lib/format.ts';
import {
  EVIDENCE_KINDS,
  drift,
  evidenceKindLabel,
  evidenceSource,
  evidenceStatus,
  evidenceTerm,
  method,
  reproMethod,
  reproSource,
  reproducibility,
  provenanceBuilder,
  sourceBasis,
  stackVersionTerm,
  testsInRebaseRecord,
  strength,
  verdict,
} from '../../lib/present.ts';
import { reasonKind } from '../../lib/overview.ts';
import { historyWindow, href, imageHref } from '../../lib/site.ts';
import { diffImage, howWords } from '../../lib/timeline.ts';

export function getStaticPaths() {
  return loadBundle().report.images.map((image) => ({ params: { id: image.id }, props: { image } }));
}

const { image } = Astro.props as { image: Image };
const { report, history } = loadBundle();
const byId = imagesById(report);
const baseImage = image.base?.imageId ? byId.get(image.base.imageId) : undefined;
const consumers = consumersOf(report, image);
const packages = image.packages === undefined ? [] : packagesOf(report, image);
const repro = image.reproducibility;
const rebasedFrom = image.factory?.rebasedFrom;
const rebasedFromImage = rebasedFrom
  ? report.images.find((i) => `${i.repository}@${i.digest}` === rebasedFrom)
  : undefined;
const signerText = (s: NonNullable<Image['evidence']['signature']['signer']>) =>
  s.identity ?? s.identityRegexp ?? s.key ?? s.sourceRepository ?? 'unknown signer';
const factory = image.factory;
const onStack = stackOf(report, image);
const packagesSource = image.packagesSource;
// The platforms this run read (estate verify --platforms), and this image's it didn't.
const readPlatforms = report.metadata.platforms;
const notRead = readPlatforms ? image.platforms.map((p) => p.platform).filter((p) => !readPlatforms.includes(p)) : [];
const listed = (list: string[]) => list.join(', ');

// This image run by run, from the history's per-image rows. Runs before
// clearcutt-verify recorded rows can't say anything about it.
const window = historyWindow();
const runs = imageRuns(history, image.id, window);
const olderRuns = (history?.entries.length ?? 0) - runs.length;
const recorded = runs.filter((run) => run.row !== undefined);
const unrecorded = runs.length - recorded.length;
const rebases = rebasesOf(runs);
// An image that was built, not rebased, needs no account of rebases it never had.
const wasRebased = rebases.length > 0 || image.evidence.rebase.status !== 'not-applicable';
const trend = (sev: 'critical' | 'high'): Point[] =>
  recorded.flatMap((run) => (run.row ? [{ at: run.at, value: run.row.vulnerabilities?.[sev] ?? null }] : []));
const showTrend = recorded.filter((run) => run.row?.vulnerabilities).length >= 2;
// The verdict's reasons: what the image failed apart from what couldn't be
// checked, which is never a failure, and never a pass.
const reasonLists = [
  { kind: 'failed', term: { label: 'Failed', tone: 'bad' as const, meaning: '' }, note: '' },
  { kind: 'unknown', term: { label: "Couldn't be checked", tone: 'unknown' as const, meaning: '' }, note: 'not a pass, and not a failure' },
]
  .map((l) => ({ ...l, reasons: image.verdict.reasons.filter((r) => reasonKind(r, image.verdict.status) === l.kind) }))
  .filter((l) => l.reasons.length > 0);
---
<Layout title={imageLabel(image)} description={`What clearcutt-verify found and proved about ${image.repository}.`}>
  <header class="page-head">
    <p class="eyebrow">Image</p>
    <h1>{imageLabel(image)}</h1>
    <p class="mono dim">{image.repository}</p>
    {image.description && <p class="lede">{image.description}</p>}
    <p><VerdictChip image={image} /></p>
    {image.observeOnly && (
      <p class="small">
        The policy observes this image without gating on it: its verdict is reported, but isn't counted with the estate's
        verified, failed, and unverified images, and doesn't fail the run.
      </p>
    )}
    {reasonLists.map((list) => (
      <div class="verdict-reasons">
        <p class="small"><StatusText term={list.term} />{list.note && <span class="dim"> · {list.note}</span>}</p>
        <ul class="reasons">{list.reasons.map((r) => <li>{r}</li>)}</ul>
      </div>
    ))}
    {notRead.length > 0 && (
      <p class="callout small">
        This run read only the {listed(readPlatforms!)} platform images (estate verify --platforms):
        this image's {listed(notRead)} {notRead.length === 1 ? 'image wasn\'t' : 'images weren\'t'} read, so {notRead.length === 1 ? 'its' : 'their'} SBOMs and
        vulnerability reports weren't looked at, and the evidence, findings, and packages here describe the platforms that were.
      </p>
    )}
    {image.warnings.length > 0 && (
      <div class="callout">
        <h2>Problems reading this image</h2>
        <ul>{image.warnings.map((w) => <li>{w}</li>)}</ul>
      </div>
    )}
  </header>

  <section aria-labelledby="identity">
    <h2 id="identity">Identity</h2>
    <dl class="kv">
      <dt>Digest</dt><dd><Digest digest={image.digest} full /></dd>
      <dt>Tags</dt><dd>{image.tags.length > 0 ? image.tags.map((t) => <code>{t}</code>) : <span class="dim">none</span>}</dd>
      <dt>Created</dt><dd>{formatTime(image.created) ?? <span class="dim">not recorded</span>}</dd>
      <dt>Built by</dt><dd><code>{image.builder.kind}</code> <span class="dim small">({image.builder.basis})</span></dd>
      <dt>Source</dt>
      <dd>
        {image.source ? (
          <>
            <ExternalLink url={image.source.url} />
            {image.source.revision && <> at <code>{image.source.revision}</code></>}{' '}
            <Chip term={sourceBasis(image.source.basis)} />
          </>
        ) : (
          <span class="dim">not recorded</span>
        )}
      </dd>
      {(image.provenance || (image.evidence.provenance.status === 'failed' && report.policy.provenanceBuilders?.length)) && (
        <>
          <dt>Provenance</dt>
          <dd>
            {image.provenance ? (
              <>
                <Chip term={provenanceBuilder(image.provenance)} />
                {image.provenance.builderId && <> builder <code>{image.provenance.builderId}</code></>}
                {image.provenance.buildType && <div class="small">build type <code>{image.provenance.buildType}</code></div>}
                <div class="dim small">{provenanceBuilder(image.provenance).meaning}</div>
              </>
            ) : (
              <span class="small">
                Nothing was read from it: the provenance failed verification (the policy requires it to name one of its
                builders, and one that names another, or none, fails), so neither its builder nor its source is taken from it.
              </span>
            )}
          </dd>
        </>
      )}
      {image.factory && (
        <>
          <dt>clearcutt-factory</dt>
          <dd>
            {[
              image.factory.kind && `${image.factory.kind}${image.factory.name ? ` ${image.factory.name}` : ''}`,
              image.factory.version && `built with ${image.factory.version}`,
              image.factory.inputs &&
                `pins ${plural(image.factory.inputs.packages, 'package')}, ${plural(image.factory.inputs.tools, 'tool')}, ${plural(image.factory.inputs.images, 'image')}`,
              image.factory.sourceDateEpoch !== undefined &&
                (formatEpochDay(image.factory.sourceDateEpoch)
                  ? `files clamped to ${formatEpochDay(image.factory.sourceDateEpoch)}`
                  : `files clamped to SOURCE_DATE_EPOCH ${image.factory.sourceDateEpoch}, which is not a date this site can show`),
            ]
              .filter(Boolean)
              .join('; ')}
          </dd>
        </>
      )}
      {factory && (factory.stack || factory.stackRef) && (
        <>
          <dt>Stack</dt>
          <dd>
            {factory.stack && <><code>{factory.stack}</code>{' '}</>}
            {factory.stackRef ? (
              <>
                from the registry stack <code>{factory.stackRef}</code>
                {factory.stackDigest && <>, pinned at <Digest digest={factory.stackDigest} /></>}.
                {onStack ? (
                  <div class="small">
                    Version: <Chip term={stackVersionTerm(onStack.version, onStack.stack.currentDigest !== undefined)} />
                    {' · '}Signature: <Chip term={evidenceStatus(onStack.version.signature.status)} />
                    {' · '}<a href={href(`stacks/#${stackAnchor(onStack.stack)}`)}>Every version of this stack</a>
                  </div>
                ) : (
                  <div class="dim small">
                    The report doesn't list this stack: clearcutt-verify lists the stacks named by verified recipes.
                  </div>
                )}
              </>
            ) : factory.stackDigest ? (
              <>defined beside the app, not in a registry; its definition's digest is <Digest digest={factory.stackDigest} />.</>
            ) : (
              <>(where it came from isn't recorded).</>
            )}
          </dd>
        </>
      )}
    </dl>
  </section>

  <section aria-labelledby="base">
    <h2 id="base">Base</h2>
    {image.base ? (
      <dl class="kv">
        <dt>Built on</dt>
        <dd>
          <code>{image.base.ref}</code>
          {baseImage && <> (<a href={imageHref(baseImage.id)}>{imageLabel(baseImage)}</a>)</>}
          {image.base.digest ? (
            <>
              <br /><Digest digest={image.base.digest} full />
              {image.base.platform && <span class="dim small"> (its {image.base.platform} image)</span>}
            </>
          ) : (
            <div class="small">
              A claimed base, no version identified: the image names this repository, but not which version of it, so
              there is no digest to compare and no image of the report to link to.
            </div>
          )}
        </dd>
        <dt>How it's known</dt>
        <dd>
          <Chip term={strength(image.base.strength)} /> by {method(image.base.method)}
          {image.base.provenOn && <>, comparing the {image.base.provenOn} images</>}.
          <span class="dim small"> {strength(image.base.strength).meaning}</span>
        </dd>
        <dt>Currency</dt>
        <dd>
          <Chip term={drift(image.base.drift)} />
          {!image.base.digest && image.base.drift === 'unknown' && <> With no version identified, how far behind it is is unknown.</>}
          {image.base.drift === 'stale' && (
            <>
              {' '}
              {daysBehind(image.base) === null
                ? `${plural(image.base.versionsBehind, 'version')} behind; how many days couldn't be measured`
                : `${plural(image.base.versionsBehind, 'version')} and ${plural(image.base.daysBehind, 'day')} behind`}
            </>
          )}
          {image.base.currentRef && (
            <div class="small">
              Newest observed: <code>{image.base.currentRef}</code> <Digest digest={image.base.currentDigest} />
              {image.base.platform && image.base.currentDigest && <span class="dim"> (its {image.base.platform} image)</span>}
            </div>
          )}
          <div class="dim small">Measured against the newest version observed in this run, not against upstream.</div>
        </dd>
      </dl>
    ) : image.root ? (
      <p><strong>Root.</strong> {image.root}</p>
    ) : (
      <>
        <p>
          <Chip term={{ label: 'Unresolved', tone: 'unknown', meaning: 'No base could be determined.' }} /> No base could be determined.
        </p>
        {(image.unresolved?.length ?? 0) > 0 && <ul class="reasons">{image.unresolved!.map((r) => <li>{r}</li>)}</ul>}
      </>
    )}
    {consumers.length > 0 && (
      <p>
        Built on this image:{' '}
        {consumers.map((c, i) => <>{i > 0 && ', '}<a href={imageHref(c.id)}>{imageLabel(c)}</a></>)}
      </p>
    )}
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">Evidence</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Evidence</th><th>Status</th><th>Signed by</th><th>Found as</th><th>When</th><th>Detail</th></tr></thead>
        <tbody>
          {EVIDENCE_KINDS.map((kind) => {
            const item = image.evidence[kind.key];
            const platforms = Object.entries(item.platforms ?? {});
            return (
              <tr>
                <td title={kind.meaning}>{kind.label}</td>
                <td><Chip term={evidenceTerm(kind.key, item)} /></td>
                <td class="small">
                  {item.signer ? (
                    <>
                      <code>{signerText(item.signer)}</code>
                      {item.signer.issuer && <div class="dim">issuer {item.signer.issuer}</div>}
                      {item.signer.sourceRepository && <div class="dim">run in {item.signer.sourceRepository}</div>}
                      {item.status !== 'verified' && <div class="dim">as its certificate claims; not checked</div>}
                    </>
                  ) : (
                    <span class="dim">—</span>
                  )}
                </td>
                <td class="small">
                  {kind.key === 'tests' && testsInRebaseRecord(image.evidence)
                    ? <>in the rebase record{item.source && <> ({evidenceSource(item.source)})</>}</>
                    : item.source ? evidenceSource(item.source) : <span class="dim">—</span>}
                </td>
                <td class="small nowrap">{formatTime(item.timestamp) ?? <span class="dim">—</span>}</td>
                <td class="small">
                  {item.detail}
                  {platforms.length > 0 && (
                    <ul class="inline-list">
                      {platforms.map(([p, s]) => <li><Chip term={evidenceStatus(s)} label={`${p}: ${evidenceStatus(s).short ?? evidenceStatus(s).label}`} /></li>)}
                    </ul>
                  )}
                  {item.ref && <div class="dim mono">{item.ref}</div>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <VerifyCommands report={report} image={image} />

  <ImageScans report={report} image={image} />

  <section aria-labelledby="tests">
    <h2 id="tests">Tests and rebuilds</h2>
    <dl class="kv">
      <dt>Tests</dt>
      <dd><Chip term={evidenceTerm('tests', image.evidence.tests)} /> {image.evidence.tests.detail}</dd>
      <dt>Rebuild</dt>
      <dd>
        <Chip term={reproducibility(repro.status)} />
        {reproMethod(repro.method) && <> {reproMethod(repro.method)}</>}
        {repro.checkedAt && <>, {formatTime(repro.checkedAt)}</>}
        {repro.digest && (
          <div class="small">
            Rebuild gave <Digest digest={repro.digest} full />
            {repro.digest === image.digest ? ', the same digest as the image.' : ', which differs from the image.'}
          </div>
        )}
        {repro.detail && <div class="small">{repro.detail}</div>}
        {!repro.digest && !repro.detail && <span class="dim small"> {reproducibility(repro.status).meaning}</span>}
        {repro.source && <div class="small">Checked by {reproSource(repro.source)}.</div>}
        {repro.signer && (
          <div class="small">
            Attestation signed by <code>{signerText(repro.signer)}</code>{repro.signer.issuer && <span class="dim"> (issuer {repro.signer.issuer})</span>}
            {repro.ref && <div class="dim mono">{repro.ref}</div>}
          </div>
        )}
        {repro.builder && (
          <div class="small">
            Where it was reproduced, as the attestation says:
            <ul class="builder">
              {repro.builder.id && <li>Run: <ExternalLink url={repro.builder.id} /></li>}
              {repro.builder.workflow && <li>Workflow <code>{repro.builder.workflow}</code>{repro.builder.job && <>, job <code>{repro.builder.job}</code></>}</li>}
              {(repro.builder.runner || repro.builder.os || repro.builder.arch) && (
                <li>Machine: {[repro.builder.runner, [repro.builder.os, repro.builder.arch].filter(Boolean).join('/')].filter(Boolean).join(', ')}</li>
              )}
              {repro.builder.factoryVersion && <li>clearcutt-factory <code>{repro.builder.factoryVersion}</code></li>}
              {repro.builder.buildkit && <li>BuildKit <code>{repro.builder.buildkit}</code></li>}
            </ul>
          </div>
        )}
      </dd>
    </dl>
  </section>

  <section aria-labelledby="rebase">
    <h2 id="rebase">Rebase history</h2>
    {rebasedFrom ? (
      <>
        <p>
          Rebased from <code>{rebasedFrom}</code>
          {rebasedFromImage && <> (<a href={imageHref(rebasedFromImage.id)}>{imageLabel(rebasedFromImage)}</a>)</>}{' '}onto {image.base ? <code>{image.base.ref}</code> : 'its base'}. Rebase record: <Chip term={evidenceStatus(image.evidence.rebase.status)} />
        </p>
      </>
    ) : (
      <p>
        <Chip term={evidenceStatus(image.evidence.rebase.status)} /> {image.evidence.rebase.detail ?? evidenceStatus(image.evidence.rebase.status).meaning}
      </p>
    )}
    {rebases.length > 0 ? (
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Rebases recorded in the history, newest first</caption>
          <thead><tr><th>First recorded</th><th>Rebased from</th><th>Gave</th><th>Rebase record</th></tr></thead>
          <tbody>
            {rebases.map((r) => (
              <tr>
                <td class="nowrap">{formatTime(r.at)}</td>
                <td class="mono small">{r.from}</td>
                <td><Digest digest={r.digest} /></td>
                <td>{r.status ? <StatusText term={evidenceStatus(r.status)} /> : <span class="dim">not recorded</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      recorded.length > 0 && wasRebased && <p class="dim small">No run in the history recorded a rebase of this image.</p>
    )}
    {history && unrecorded > 0 && wasRebased && (
      <p class="dim small">
        {plural(unrecorded, 'run')} in the history recorded no per-image rows, so any rebase then isn't known.
      </p>
    )}
  </section>

  <section aria-labelledby="over-time">
    <h2 id="over-time">This image over time</h2>
    {!history ? (
      <p class="dim">This bundle has no history, so there is only this run.</p>
    ) : runs.length === 0 ? (
      <p class="dim">The history lists no runs, so there is only this run.</p>
    ) : recorded.length === 0 ? (
      <p class="dim">
        The history has {plural(runs.length, 'run')}, but none of them recorded per-image rows (clearcutt-verify writes
        them from v0.15), so what this image was in earlier runs isn't known.
      </p>
    ) : (
      <>
        <p class="lede small">
          This image in each run that recorded per-image rows, newest first, and how it changed since the run before:
          rebuilt or rebased (a new digest), or its base moved (the same image, its base more or less current).{' '}
          <a href={href('history/changes/')}>Compare two runs</a> for every image at once.
        </p>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">This image in each run, newest first</caption>
            <thead>
              <tr><th>Run</th><th>Digest</th><th>Verdict</th><th>Base</th><th class="num">Critical</th><th class="num">High</th></tr>
            </thead>
            <tbody>
              {recorded.map((run, i) => {
                const row = run.row;
                const older = recorded.slice(i + 1).find((r) => r.row)?.row;
                if (!row) {
                  return (
                    <tr><td class="nowrap">{formatTime(run.at)}</td><td colspan="5" class="dim">Not in this run.</td></tr>
                  );
                }
                return (
                  <tr>
                    <td class="nowrap">{formatTime(run.at)}</td>
                    <td>
                      <Digest digest={row.digest} />
                      {older && diffImage(image.id, older, row).how !== 'unchanged' && <div class="small">{howWords(diffImage(image.id, older, row)).label.toLowerCase()}</div>}
                    </td>
                    <td><StatusText term={verdict(row.verdict)} /></td>
                    <td class="small">
                      {row.base ? (
                        <>
                          <StatusText term={strength(row.base.strength)} />, <StatusText term={drift(row.base.drift)} label={drift(row.base.drift).label.toLowerCase()} />
                          {row.base.digest && <div><Digest digest={row.base.digest} />{row.base.platform && <span class="dim"> ({row.base.platform})</span>}</div>}
                        </>
                      ) : (
                        <span class="dim">none recorded</span>
                      )}
                    </td>
                    <td class="num">{row.vulnerabilities ? row.vulnerabilities.critical : '?'}</td>
                    <td class="num">{row.vulnerabilities ? row.vulnerabilities.high : '?'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="small dim">
          ? means unknown: the run had no vulnerability data for this image.
          {olderRuns > 0 && ` This shows the latest ${plural(runs.length, 'run')}; ${plural(olderRuns, 'older one is', 'older ones are')} in estate-history.json.`}
          {unrecorded > 0 && ` ${plural(unrecorded, 'earlier run')} recorded no per-image rows and ${unrecorded === 1 ? "isn't" : "aren't"} shown.`}
        </p>
        {showTrend && (
          <div class="multiples">
            <LineChart title="Critical findings" points={trend('critical')} valuesIn="the table above" />
            <LineChart title="High findings" points={trend('high')} valuesIn="the table above" />
          </div>
        )}
      </>
    )}
  </section>

  <section aria-labelledby="platforms">
    <h2 id="platforms">Platforms</h2>
    {image.platforms.length === 0 ? (
      <p>
        <Chip term={{ label: 'Unknown', tone: 'unknown', meaning: "The image's platform list couldn't be read." }} /> The report lists no
        platform images: this image's platform list couldn't be read, so which platforms it has is unknown.
      </p>
    ) : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Platform</th><th>Digest</th><th class="num">Layers</th><th class="num">Compressed size</th>{readPlatforms && <th>This run</th>}</tr></thead>
        <tbody>
          {image.platforms.map((p) => (
            <tr>
              <td>{p.platform}</td><td><Digest digest={p.digest} full /></td><td class="num">{p.layers}</td><td class="num">{bytes(p.size)}</td>
              {readPlatforms && <td class="small">{readPlatforms.includes(p.platform) ? 'read' : <strong>not read</strong>}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    )}
  </section>

  <section aria-labelledby="packages">
    <h2 id="packages">Packages</h2>
    {image.packages === undefined ? (
      <p>
        <Chip term={{ label: 'Unknown', tone: 'unknown', meaning: 'The report has no package set for this image.' }} /> The report
        has no package set for this image, so what it ships is unknown.
      </p>
    ) : (
      <>
      <p>
        {packagesSource ? (
          <>
            Read from its {evidenceKindLabel(packagesSource.evidence)}, which is{' '}
            <Chip term={evidenceStatus(packagesSource.status)} />
            {packagesSource.platforms && packagesSource.platforms.length > 0 && (
              <>; {packagesSource.platforms.length > 1 ? `the union of the ${packagesSource.platforms.join(', ')} images' lists` : `the ${packagesSource.platforms[0]} image's list`}</>
            )}.
            {packagesSource.status !== 'verified' && (
              <> No trusted signer verified all of it, so the list may not be complete.</>
            )}
          </>
        ) : (
          <span class="dim">Where this package set was read from isn't recorded.</span>
        )}
      </p>
      <details>
        <summary>{plural(image.packages, 'package version')}</summary>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Package</th><th>Version</th><th>Type</th></tr></thead>
            <tbody>
              {packages.map((p) => <tr><td>{p.name}</td><td class="mono">{p.version}</td><td>{p.type}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
      </>
    )}
  </section>
</Layout>
