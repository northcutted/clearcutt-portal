---
import Layout from '../layouts/Layout.astro';
import AdvisoryLinks from '../components/AdvisoryLinks.astro';
import ImagesTable from '../components/ImagesTable.astro';
import PolicySummary from '../components/PolicySummary.astro';
import StatusText from '../components/StatusText.astro';
import Tile from '../components/Tile.astro';
import { loadBundle } from '../lib/bundle.ts';
import { byVerdict, daysBehind, imageLabel, staleImages } from '../lib/estate.ts';
import { affectedImages, findingGroups, isSevere } from '../lib/findings.ts';
import { formatTime, plural } from '../lib/format.ts';
import { formatAge, listPath, oldScans, outstanding, reasonGroups, scanAges } from '../lib/overview.ts';
import {
  EVIDENCE_KINDS,
  SEVERITIES,
  TONE_GLYPH,
  evidenceStatus,
  reproducedTone,
  strength,
  verdict,
  type Tone,
} from '../lib/present.ts';
import { href, imageHref, scanAgeDays } from '../lib/site.ts';
import Chip from '../components/Chip.astro';

const { report } = loadBundle();
const { summary, metadata, policy } = report;
const images = byVerdict(report.images);
const stale = staleImages(report);
const reasons = reasonGroups(report);
const withBase = summary.bases.proven + summary.bases.claimed;
const repro = summary.reproducibility;
const recipes = repro.reproduced + repro.notReproduced + repro.notChecked;
const stacks = report.stacks ?? [];
const stackConsumers = stacks.reduce((n, s) => n + s.consumers, 0);
const staleOnStacks = stacks.reduce((n, s) => n + s.staleConsumers, 0);
const vulns = summary.vulnerabilities;
const scanDays = scanAgeDays();
const ages = scanAges(report);
const oldest = ages.dated[0];
const old = oldScans(report, scanDays);
const todo = outstanding(report, scanDays);
// What the verdicts don't already say.
const besides = todo.filter((t) => t.path !== listPath('failed') && t.path !== listPath('unverified'));
const passes = summary.verdicts.failed === 0 && summary.verdicts.unverified === 0;
const groups = findingGroups(report);
// The findings to fix first: fixable critical and high, then critical and
// high with no fix known.
const fixFirst = groups.filter((g) => g.counted.length > 0 && isSevere(g.severity));
const SHOW = 10;
// A reason's images: a few inline, the rest a click away.
const INLINE = 12;

const verdictTiles = (['verified', 'failed', 'unverified'] as const).map((status) => {
  const term = verdict(status);
  return { value: summary.verdicts[status], label: term.label, note: term.meaning, tone: term.tone, path: listPath(status) };
});

const severe = vulns.counts.critical + vulns.counts.high;
const otherTiles: { label: string; value: string | number; tone: Tone; note: string; path: string }[] = [
  {
    label: 'Critical and high findings',
    value: vulns.scanned > 0 ? severe : '?',
    tone: vulns.scanned === 0 ? 'unknown' : vulns.counts.critical > 0 ? 'bad' : vulns.counts.high > 0 ? 'warn' : 'good',
    note:
      vulns.scanned === 0
        ? 'unknown: no image has vulnerability data'
        : `${vulns.fixable.critical + vulns.fixable.high} with a fix, in ${plural(vulns.scanned, 'scanned image')}${vulns.notScanned > 0 ? ' (a floor)' : ''}`,
    path: 'findings/',
  },
  {
    label: 'On a stale base',
    value: summary.bases.stale,
    tone: summary.bases.stale > 0 ? 'warn' : 'good',
    note: `of ${plural(withBase, 'image')} with a known base`,
    path: listPath('stale-base'),
  },
  {
    label: 'Base proven',
    value: summary.bases.proven,
    tone: 'good',
    note: `by layer digests; ${summary.bases.claimed} more rest on a claim`,
    path: listPath('base-proven'),
  },
  {
    label: 'Base unresolved',
    value: summary.bases.unresolved,
    tone: summary.bases.unresolved > 0 ? 'unknown' : 'muted',
    note: 'no base could be determined',
    path: listPath('base-unresolved'),
  },
  {
    label: 'Vulnerabilities unknown',
    value: vulns.notScanned,
    tone: vulns.notScanned > 0 ? 'unknown' : 'muted',
    note: 'images with no vulnerability data',
    path: listPath('not-scanned'),
  },
  {
    label: 'Oldest scan',
    value: oldest ? formatAge(oldest.ms) : '?',
    tone: old.length > 0 ? 'warn' : ages.undated.length > 0 || !oldest ? 'unknown' : 'good',
    note: oldest
      ? `${imageLabel(oldest.image)}; ${old.length > 0 ? `${plural(old.length, 'scan is', 'scans are')} over` : 'none over'} ${plural(scanDays, 'day')}${ages.undated.length > 0 ? `, ${ages.undated.length} undated` : ''}`
      : ages.undated.length > 0
        ? `${plural(ages.undated.length, 'scan has', 'scans have')} no date`
        : 'no image has vulnerability data',
    path: listPath('old-scans'),
  },
  {
    label: 'Reproduced',
    value: repro.reproduced,
    tone: reproducedTone(repro),
    note: `of ${plural(recipes, 'image')} with a recipe or rebase record${policy.reproduce ? '' : ' (this run did not rebuild)'}`,
    path: listPath('reproduced'),
  },
  {
    label: 'Not reproduced',
    value: repro.notReproduced,
    tone: repro.notReproduced > 0 ? 'bad' : recipes === 0 ? 'muted' : 'good',
    note: `rebuilt to a different digest${repro.notChecked > 0 ? `; ${repro.notChecked} not checked` : ''}`,
    path: listPath('not-reproduced'),
  },
  ...(stacks.length > 0
    ? [
        {
          label: 'On an older stack',
          value: staleOnStacks,
          tone: (staleOnStacks > 0 ? 'warn' : 'good') as Tone,
          note: `of ${plural(stackConsumers, 'app')} on ${plural(stacks.length, 'registry stack')}`,
          path: 'stacks/',
        },
      ]
    : []),
];

const evidenceColumns = [
  { key: 'verified', status: 'verified' },
  { key: 'present', status: 'present' },
  { key: 'failed', status: 'failed' },
  { key: 'missing', status: 'missing' },
  { key: 'unknown', status: 'unknown' },
  { key: 'notApplicable', status: 'not-applicable' },
] as const;
const sources = metadata.sources.map((s) => [s.registry, s.namespace].filter(Boolean).join('/'));
const capital = (s: string) => `${s[0].toUpperCase()}${s.slice(1)}`;
---
<Layout title="Overview">
  <header class="page-head">
    <p class="eyebrow">Estate overview</p>
    <h1>{metadata.name}</h1>
    <p class="lede">
      {metadata.generator.name} checked {plural(summary.images, 'image')} from {sources.join(', ')} against the
      policy below, finishing at {formatTime(metadata.generatedAt)}. Each image is verified, failed, or unverified,
      with the reasons it wasn't verified.
    </p>
  </header>

  <section class="standing" aria-labelledby="standing">
    <h2 id="standing" class="sr-only">Where the estate stands</h2>
    <p class="standing-head">
      {passes ? (
        <><StatusText term={{ label: 'Policy passes:', tone: 'good', meaning: '' }} /> {summary.images === 1 ? 'the image is' : `all ${summary.images} images are`} verified.</>
      ) : (
        <>
          <StatusText term={{ label: 'Policy does not pass:', tone: summary.verdicts.failed > 0 ? 'bad' : 'unknown', meaning: '' }} /> of{' '}
          {plural(summary.images, 'image')},{' '}
          {[
            summary.verdicts.failed > 0 && `${summary.verdicts.failed} ${summary.verdicts.failed === 1 ? 'fails' : 'fail'} it`,
            summary.verdicts.unverified > 0 && `${summary.verdicts.unverified} ${summary.verdicts.unverified === 1 ? 'is' : 'are'} unverified`,
          ]
            .filter(Boolean)
            .join(' and ')}.
        </>
      )}
    </p>
    {besides.length > 0 ? (
      <>
        <p>{passes ? "Still outstanding, though the policy doesn't fail them:" : 'Also outstanding:'}</p>
        <ul class="outstanding">
          {besides.map((t) => (
            <li><span class={`chip-glyph tone-${t.tone}`} aria-hidden="true">{TONE_GLYPH[t.tone]}</span> <a href={href(t.path)}>{capital(t.text)}</a></li>
          ))}
        </ul>
      </>
    ) : (
      <p class="small">
        Nothing else is outstanding: no critical or high findings, no image on a stale base, no rebuild that didn't
        reproduce, and every image has vulnerability data no older than {plural(scanDays, 'day')}.
      </p>
    )}
  </section>

  <section aria-labelledby="verdicts">
    <h2 id="verdicts">Verdicts</h2>
    <div class="tiles">
      {verdictTiles.map((tile) => <Tile value={tile.value} label={tile.label} note={tile.note} tone={tile.tone} glyph path={tile.path} />)}
    </div>
    <div class="tiles">
      {otherTiles.map((tile) => <Tile value={tile.value} label={tile.label} note={tile.note} tone={tile.tone} path={tile.path} />)}
    </div>
    <p class="small dim">Each number opens the list of what it counts.</p>
  </section>

  {report.warnings.length > 0 && (
    <section class="callout" aria-labelledby="warnings">
      <h2 id="warnings">Problems this run hit</h2>
      <ul>{report.warnings.map((w) => <li>{w}</li>)}</ul>
    </section>
  )}

  <section aria-labelledby="attention">
    <h2 id="attention">Not verified, and why</h2>
    {reasons.length === 0 ? (
      <p>No image falls short of the policy.{besides.length > 0 && <> What is still outstanding is listed above.</>}</p>
    ) : (
      <>
        <p class="lede small">
          One card per reason, with every image it holds back: fix a reason and every image on its card moves. Reasons that
          fail an image come first, then those that hold back the most images. An image can be on more than one card.
        </p>
        <div class="grid reasons-grid">
          {reasons.map((group) => {
            const shown = group.images.slice(0, INLINE);
            const rest = group.images.slice(INLINE);
            const item = ({ image, reason }: (typeof group.images)[number]) => (
              <li>
                <a href={imageHref(image.id)}>{imageLabel(image)}</a> <StatusText term={verdict(image.verdict.status)} />
                {reason !== group.text && <div class="dim small">{reason}</div>}
              </li>
            );
            return (
              <article class="card">
                <h3>{capital(group.text)}</h3>
                <p class="small">
                  {plural(group.images.length, 'image', 'images')}
                  {group.failed > 0 && group.unverified > 0 && <>: {group.failed} failed, {group.unverified} unverified</>}
                  {group.failed > 0 && group.unverified === 0 && <>, failed</>}
                  {group.failed === 0 && <>, unverified</>}
                </p>
                <ul class="reason-images">{shown.map(item)}</ul>
                {rest.length > 0 && (
                  <details>
                    <summary>{plural(rest.length, 'more image', 'more images')}</summary>
                    <ul class="reason-images">{rest.map(item)}</ul>
                  </details>
                )}
              </article>
            );
          })}
        </div>
      </>
    )}
  </section>

  <section aria-labelledby="fix-first">
    <h2 id="fix-first">Findings to fix first</h2>
    {vulns.scanned === 0 ? (
      <p>No image has vulnerability data, so what there is to fix is unknown.</p>
    ) : fixFirst.length === 0 ? (
      <p>
        No image with vulnerability data has a critical or high finding.{vulns.notScanned > 0 && <> {plural(vulns.notScanned, 'image has', 'images have')} none, so {vulns.notScanned === 1 ? 'its findings are' : 'theirs are'} unknown.</>}{' '}
        <a href={href('findings/')}>Every finding</a>.
      </p>
    ) : (
      <>
        <p class="lede small">
          Critical and high findings with a fixed version first, then those with no fix known, each with the images that have
          it. {vulns.notScanned > 0 && <>{plural(vulns.notScanned, 'image has', 'images have')} no vulnerability data, so this is a floor. </>}
          <a href={href('findings/')}>Every finding</a>, by advisory.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Finding</th><th>Severity</th><th>Fixed in</th><th>Package</th><th class="num">Images</th></tr></thead>
            <tbody>
              {fixFirst.slice(0, SHOW).map((g) => {
                const fixes = [...new Set(g.counted.flatMap((o) => o.finding.fixedIn ?? []))];
                return (
                  <tr>
                    <td><a class="mono" href={href(`findings/${encodeURIComponent(g.slug)}/`)}>{g.id}</a><div class="small"><AdvisoryLinks id={g.id} /></div></td>
                    <td>{g.severity}</td>
                    <td class="mono small">{fixes.length > 0 ? fixes.join(', ') : <span class="dim">no fix known</span>}</td>
                    <td class="mono small">{g.packages.join(', ')}</td>
                    <td class="num">{affectedImages(g).length}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {fixFirst.length > SHOW && <p class="small"><a href={href('findings/')}>{plural(fixFirst.length - SHOW, 'more critical or high finding', 'more critical or high findings')}</a></p>}
      </>
    )}
  </section>

  <section aria-labelledby="stale">
    <h2 id="stale">Stale bases</h2>
    {stale.length === 0 ? (
      <p>No image is on an older version of its base than the newest one this run observed.</p>
    ) : (
      <>
        <p class="lede small">
          Behind is measured against the newest version of the same base observed in this run, not against upstream.
          {policy.maxDaysBehind ? ` The policy fails images more than ${policy.maxDaysBehind} days behind.` : ' The policy sets no limit.'}
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Image</th><th>Base</th><th>How it's known</th><th class="num">Versions behind</th><th class="num">Days behind</th></tr>
            </thead>
            <tbody>
              {stale.map((image) => (
                <tr>
                  <td><a href={imageHref(image.id)}>{imageLabel(image)}</a></td>
                  <td class="mono">{image.base.ref}</td>
                  <td><Chip term={strength(image.base.strength)} /></td>
                  <td class="num">{image.base.versionsBehind}</td>
                  <td class="num">
                    {daysBehind(image.base) === null ? (
                      <span class="dim">unknown</span>
                    ) : (
                      <>
                        {image.base.daysBehind}
                        {policy.maxDaysBehind && image.base.daysBehind > policy.maxDaysBehind ? ' (over the limit)' : ''}
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </section>

  <section aria-labelledby="images">
    <h2 id="images">Images</h2>
    <ImagesTable images={images} caption="Every image: verdict, base, evidence, vulnerabilities, scan age, and rebuild" />
    <p class="small dim">
      {(['good', 'claim', 'warn', 'bad', 'unknown', 'muted'] as Tone[]).map((tone, i) => {
        const names: Record<Tone, string> = {
          good: 'verified',
          claim: 'present, unverified',
          warn: 'missing',
          bad: 'failed',
          unknown: 'unknown',
          muted: 'not applicable',
        };
        return <>{i > 0 && ' · '}<span class={`chip-glyph tone-${tone}`}>{TONE_GLYPH[tone]}</span> {names[tone]}</>;
      })}
    </p>
  </section>

  <section aria-labelledby="evidence">
    <h2 id="evidence">Evidence across the estate</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Evidence</th>
            {evidenceColumns.map((c) => <th class="num">{evidenceStatus(c.status).short ?? evidenceStatus(c.status).label}</th>)}
          </tr>
        </thead>
        <tbody>
          {EVIDENCE_KINDS.map((kind) => {
            const counts = summary.evidence[kind.key];
            return (
              <tr>
                <td title={kind.meaning}>{kind.label}</td>
                {evidenceColumns.map((c) => <td class="num">{counts ? counts[c.key] : '—'}</td>)}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="vulns">
    <h2 id="vulns">Vulnerabilities</h2>
    <p class="lede small">
      Totals over the {plural(vulns.scanned, 'image')} with vulnerability data.
      {vulns.notScanned > 0
        ? ` ${plural(vulns.notScanned, 'image has', 'images have')} none, so their vulnerabilities are unknown and these totals are a floor for the estate, not its total.`
        : ' Every image has vulnerability data.'}{' '}
      Each image's findings describe the day its report was made.
    </p>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th>{SEVERITIES.map((s) => <th class="num">{s}</th>)}</tr></thead>
        <tbody>
          <tr><td>Findings</td>{SEVERITIES.map((s) => <td class="num">{vulns.counts[s]}</td>)}</tr>
          <tr><td>With a fix</td>{SEVERITIES.map((s) => <td class="num">{vulns.fixable[s]}</td>)}</tr>
        </tbody>
      </table>
    </div>
  </section>

  <PolicySummary policy={policy} stacks={report.stacks?.length ?? 0} />

  <aside class="callout" aria-labelledby="limits">
    <h2 id="limits">What this does not prove</h2>
    <ul>
      <li>A verified signature or attestation proves who signed it, as the policy defines trust. It doesn't prove the image is safe to run.</li>
      <li>"Present" evidence exists but wasn't checked against a trusted signer. Treat it as a claim.</li>
      <li>Vulnerability findings describe the day each report was made. Newer advisories aren't in them.</li>
      <li>Staleness is measured against the newest base version observed in this run. A base that is itself out of date leaves its consumers looking current.</li>
      <li>Unknown means unknown. It is never counted as zero, absent, or a pass.</li>
    </ul>
  </aside>
</Layout>
