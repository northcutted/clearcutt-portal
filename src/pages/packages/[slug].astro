---
import Layout from '../../layouts/Layout.astro';
import Chip from '../../components/Chip.astro';
import PackagesUnknown from '../../components/PackagesUnknown.astro';
import { loadBundle } from '../../lib/bundle.ts';
import { imageLabel, imagesById, packageGroups, type PackageGroup } from '../../lib/estate.ts';
import { plural } from '../../lib/format.ts';
import { advisoriesIn, affectedImages } from '../../lib/findings.ts';
import { rescannedRun } from '../../lib/overview.ts';
import { answerFor, inheritedWords } from '../../lib/package-search.ts';
import { evidenceKindLabel, evidenceStatus, gatingScan, scanSourceShort } from '../../lib/present.ts';
import { href, imageHref, indexedPackage, searchIndex } from '../../lib/site.ts';

export function getStaticPaths() {
  return packageGroups(loadBundle().report).map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props as { group: PackageGroup };
const { report } = loadBundle();
const byId = imagesById(report);
const label = (id: string) => (byId.get(id) ? imageLabel(byId.get(id)!) : id);

// The images built on one that ships each version: the same answer the
// search gives, for readers without script.
const index = searchIndex();
const indexed = indexedPackage(group.slug)!;
const inheritedBy = new Map(group.versions.map((v) => [v.version, answerFor(index, indexed, new Set([v.version])).inherited]));
const inheriting = new Set([...inheritedBy.values()].flatMap((list) => list.filter((i) => i.own === 'unknown').map((i) => i.id)));
for (const id of group.images) inheriting.delete(id);
const searchFor = href(`packages/?q=${encodeURIComponent(`${group.type}:${group.name}`)}#search`);
// What the scans the policy gated on found in each version.
const advisories = new Map(group.versions.map((v) => [v.version, advisoriesIn(report, group.name, v.version)]));
const fromScans = rescannedRun(report) ? scanSourceShort(gatingScan(report.policy)) : "the publishers' scans";
---
<Layout title={group.name} description={`Which images ship ${group.name}.`}>
  <header class="page-head">
    <p class="eyebrow">Package · {group.type}</p>
    <h1>{group.name}</h1>
    <p class="lede">
      {plural(group.images.length, 'image ships', 'images ship')} it, in {plural(group.versions.length, 'version')}{inheriting.size > 0 && <>, and {plural(inheriting.size, 'more image inherits', 'more images inherit')} it from a base</>}.
      Oldest version first. <a href={searchFor}>Search its versions</a>.
    </p>
  </header>

  <PackagesUnknown />

  {group.versions.map((v) => (
    <section>
      <h2 class="mono">{v.version}</h2>
      {v.purl && <p class="small dim mono">{v.purl}</p>}
      <div class="table-wrap">
        <table>
          <thead><tr><th>Image</th><th>Repository</th><th>Package list read from</th></tr></thead>
          <tbody>
            {v.images.map((id) => {
              const image = byId.get(id)!;
              const source = image.packagesSource;
              return (
                <tr>
                  <td><a href={imageHref(id)}>{imageLabel(image)}</a></td>
                  <td class="mono small">{image.repository}</td>
                  <td>
                    {source ? (
                      <>
                        {evidenceKindLabel(source.evidence)} <Chip term={evidenceStatus(source.status)} />
                        {source.platforms && source.platforms.length > 0 && <div class="dim small">{source.platforms.join(', ')}</div>}
                      </>
                    ) : (
                      <span class="dim">not recorded</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {(advisories.get(v.version)?.length ?? 0) > 0 && (
        <div class="table-wrap">
          <table>
            <caption class="small">Advisories in {group.name} {v.version}, from {fromScans}</caption>
            <thead><tr><th>Advisory</th><th>Severity</th><th>Fixed in</th><th class="num">Images that count it</th><th class="num">Suppressed in</th></tr></thead>
            <tbody>
              {advisories.get(v.version)!.map((a) => {
                const fixes = [...new Set([...a.counted, ...a.suppressed].flatMap((o) => o.finding.fixedIn ?? []))];
                return (
                  <tr>
                    <td><a class="mono nowrap" href={href(`findings/${encodeURIComponent(a.slug)}/`)}>{a.id}</a></td>
                    <td>{a.severity}</td>
                    <td class="mono small">{fixes.length > 0 ? fixes.join(', ') : <span class="dim">no fix known</span>}</td>
                    <td class="num">{affectedImages(a).length}</td>
                    <td class="num">{new Set(a.suppressed.map((o) => o.image.id)).size}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      {(inheritedBy.get(v.version)?.length ?? 0) > 0 && (
        <div class="table-wrap">
          <table>
            <caption class="sr-only">Images built on one that ships {v.version}</caption>
            <thead><tr><th>Built on one that ships it</th><th>How</th></tr></thead>
            <tbody>
              {inheritedBy.get(v.version)!.map((entry) => {
                const words = inheritedWords(entry, label);
                return (
                  <tr>
                    <td><a href={imageHref(entry.id)}>{label(entry.id)}</a></td>
                    <td><strong>{words.label}</strong><div class="small dim">{words.detail}</div></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>
  ))}

  <p class="small dim">
    Each image's package list was read from the evidence named, for the platform images listed (its packages are
    their union). Verified means a trusted signer vouched for all of it; anything else means some of it wasn't
    verified, so the list may not be complete. Not recorded means the report doesn't say where it came from.
  </p>
</Layout>
