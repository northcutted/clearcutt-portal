---
// One glyph per evidence kind, in the order of EVIDENCE_KINDS.
import type { Image } from '../lib/contract.gen.ts';
import { EVIDENCE_KINDS, evidenceStatus } from '../lib/present.ts';
import StatusCell from './StatusCell.astro';

interface Props {
  image: Image;
}
const { image } = Astro.props;
---
{EVIDENCE_KINDS.map((kind) => {
  const item = image.evidence[kind.key];
  return (
    <td class="center tight">
      <StatusCell term={evidenceStatus(item.status)} subject={kind.label} detail={item.detail} />
    </td>
  );
})}
